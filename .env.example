# EMAIL_HOST is ignored when EMAIL_SERVICE is a service nodemailer knows.
# sendgrid: SENDGRID_API_KEY, FROM_EMAIL (a verified sender).
# FROM_SENDER is the name shown beside FROM_EMAIL, and is optional.
